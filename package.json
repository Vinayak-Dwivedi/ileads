{
  "name": "qms-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 127.0.0.1 -p 3010",
    "start:prod": "next start -H 127.0.0.1 -p 3010",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "import:audio": "tsx scripts/import-existing-audio.ts",
    "smoke:stt": "tsx --require ./scripts/_stt-preload.cjs scripts/smoke-test-stt.ts",
    "smoke:audit": "tsx --require ./scripts/_stt-preload.cjs scripts/smoke-test-live-audit.ts",
    "calibrate:speakers": "tsx scripts/calibrate-speakers.ts",
    "truncate:demo-calls": "tsx --require ./scripts/_stt-preload.cjs scripts/truncate-demo-call-data.ts",
    "import:beetel-parameters": "tsx scripts/import-beetel-parameters.ts",
    "import:standard-parameters": "tsx scripts/import-standard-parameters.ts",
    "reset:beetel-parameters": "tsx scripts/reset-beetel-parameters.ts",
    "worker:queue": "tsx --require ./scripts/_stt-preload.cjs scripts/queue-worker.ts",
    "worker:bullmq": "tsx --require ./scripts/_stt-preload.cjs scripts/bullmq-worker.ts",
    "user:create": "tsx scripts/create-user.ts",
    "apikey:create": "tsx scripts/create-api-key.ts",
    "webhook:create": "tsx scripts/create-webhook.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@aws-sdk/s3-request-presigner": "^3.1051.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@sentry/nextjs": "^10.53.1",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.185",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.469.0",
    "media-chrome": "^4.19.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
