    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.5.0",
    "enhanced-resolve": "^5.21.4",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
