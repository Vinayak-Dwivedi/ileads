# Copy to .env and fill in real values. Never commit a populated .env.

DATABASE_URL="postgresql://user:password@localhost:5432/ileads_qms?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
# Must be >= 32 chars. Unique per environment. Loss = all sessions invalidated; leak = sessions forgeable.
APP_SECRET="REPLACE_WITH_RANDOM_64_BYTE_VALUE"

# Single-tenant legacy login password (phased out in Phase 1).
APP_PASSWORD="change-me"

NEXT_PUBLIC_BASE_PATH=""
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# === STT (Speech-to-Text) ===
STT_PROVIDER=sarvam               # sarvam | deepgram | local
MOCK_STT=false
SARVAM_API_KEY=""                 # https://dashboard.sarvam.ai (account must have credits)
# Sarvam runs through the native `sarvamai` Node SDK by default — NO Python
# needed. It uses the Batch job API (diarization + long audio). Optional:
SARVAM_LANGUAGE_CODE=""           # "" = auto-detect, or hi-IN / en-IN / ta-IN / ...
SARVAM_STT_MODEL=saaras:v3        # saaras:v3 (supports `mode`) | saarika:v2.5
SARVAM_STT_MODE=transcribe        # saaras:v3 only: transcribe | translate | verbatim | translit | codemix
SARVAM_BATCH_TIMEOUT_SECONDS=900
SARVAM_BATCH_POLL_INTERVAL_SECONDS=10
SARVAM_USE_PYTHON_ENGINE=false    # true = legacy Python adapter (needs STT_PYTHON_BIN + stt/ scripts)
DEEPGRAM_API_KEY=""               # https://console.deepgram.com — used by the deepgram STT engine
DEEPGRAM_MODEL=nova-2             # nova-2 | nova-2-general | enhanced | etc
DEEPGRAM_LANGUAGE=multi           # ISO code or "multi" for auto-detect
STT_PYTHON_BIN=""                 # only needed when SARVAM_USE_PYTHON_ENGINE=true or STT_PROVIDER=local

# === LLM Audit ===
AUDIT_PROVIDER=openrouter         # openrouter | gemini
OPENROUTER_API_KEY=""             # https://openrouter.ai/keys
OPENROUTER_AUDIT_MODEL="google/gemini-2.5-flash"
OPENROUTER_AUDIT_FALLBACK_MODELS="" # optional comma-separated fallback models
# Used only when AUDIT_PROVIDER=gemini (direct Google AI Studio key).
GEMINI_API_KEY=""                 # https://aistudio.google.com/apikey
GEMINI_AUDIT_MODEL="gemini-2.5-flash"

# === Storage ===
AUDIO_STORAGE_PROVIDER="local"       # local | s3
AUDIO_STORAGE_PATH="./storage/audio" # used when provider=local
MAX_AUDIO_UPLOAD_MB="100"

# S3-compatible storage (AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO).
# Only required when AUDIO_STORAGE_PROVIDER=s3.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""                       # leave blank for AWS, set for R2/B2/MinIO
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"          # set true for MinIO; false for AWS/R2/B2
S3_PUBLIC_BASE_URL=""                # optional: CDN base url for direct playback

# Comma-separated hostnames allowed to bypass the SSRF guard (e.g. "internal-cdn.local").
# Leave EMPTY in production.
AUDIO_DOWNLOAD_PRIVATE_HOST_ALLOWLIST=""

# === Queue (BullMQ / Redis) ===
# When REDIS_URL is set, scripts/bullmq-worker.ts is the recommended worker
# (`npm run worker:bullmq`). When empty, scripts/queue-worker.ts handles
# processing via Postgres polling (`npm run worker:queue`). Both can run, but
# pick one in production.
REDIS_URL=""
QUEUE_CONCURRENCY=2

# === REST API (/api/v1/*) rate limit, per API key ===
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000

# === Excel import ===
EXCEL_IMPORT_MAX_ROWS=500

# === UI ===
SHOW_MOCK_ACTIONS=false

# === Auth brute-force protection ===
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes

# === Observability (Sentry) ===
# Leave empty in dev to disable. Get DSN from https://sentry.io project settings.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

# === Database pool ===
# When fronted by PgBouncer in transaction mode, also append `?pgbouncer=true`
# to DATABASE_URL so Prisma disables prepared statements.
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT_SECONDS=10

# Optional read replica. When set, dashboard aggregates + list endpoints
# read from this URL; writes still hit DATABASE_URL. Replication is async,
# so "read what I just wrote" code paths must keep using the primary.
DATABASE_REPLICA_URL=""
