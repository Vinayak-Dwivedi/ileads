DATABASE_URL="postgresql://ileads_qms_user:CHANGE_ME@localhost:5432/ileads_qms?schema=public"

APP_SECRET="change-me-long-random-secret"
APP_PASSWORD="demo-password"

NEXT_PUBLIC_BASE_PATH="/ileads-qms"
APP_BASE_URL="http://187.127.139.47/ileads-qms"
NODE_ENV="production"

OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_AUDIT_MODEL="google/gemma-4-31b-it:free"
OPENROUTER_CLEANUP_MODEL="google/gemma-4-31b-it:free"
OPENROUTER_TIMEOUT_SECONDS="120"

MOCK_STT="true"
MOCK_LLM="true"

STT_PRIMARY_PROVIDER="local"
STT_PRIMARY_MODEL="indicwhisper"
STT_PRIMARY_MODEL_PATH="/models/indicwhisper"
STT_PRIMARY_DEVICE="cuda"
STT_PRIMARY_LANGUAGE="hi"

STT_FALLBACK_PROVIDER="local"
STT_FALLBACK_MODEL="indicconformer"
STT_FALLBACK_MODEL_PATH="/models/indicconformer"
STT_FALLBACK_DEVICE="cuda"
STT_FALLBACK_LANGUAGE="hi"

STT_CONFIDENCE_THRESHOLD_GOOD="0.75"
STT_CONFIDENCE_THRESHOLD_FALLBACK="0.50"
STT_ENABLE_FALLBACK="true"
STT_CHUNK_SECONDS="30"
STT_SAMPLE_RATE="16000"

ENABLE_TRANSCRIPT_CLEANUP="false"

AUDIO_STORAGE_PROVIDER="local"
AUDIO_STORAGE_PATH="./storage/audio"
MAX_AUDIO_UPLOAD_MB="100"
